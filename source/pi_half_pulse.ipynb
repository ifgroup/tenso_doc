    "    'axes.titlesize': 16,\n",
    "    'lines.linewidth': 2,\n",
    "    'xtick.direction': 'out',\n",
    "    'ytick.direction': 'out',\n",
    "    'xtick.major.size': 5,\n",
    "    'ytick.major.size': 5,\n",
    "    'legend.fontsize': 12,\n",
    "    'figure.dpi': 300,\n",
    "})\n",
    "\n",
    "\n",
    "# --- Read data ---\n",
    "filename = 'laser_result_300K.dat.log'  # Cambia al nombre real de tu archivo\n",
    "data = np.loadtxt(filename, delimiter=' ', dtype=complex)\n",
    "\n",
    "t_fs = data[:, 0].real\n",
    "pop_exc = data[:, 1].real\n",
    "coh_01 = np.abs(data[:, 2])\n",
    "coh_10= np.abs(data[:, 3])\n",
    "pop_gnd = data[:, 4].real\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# --- Plot\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 4), sharex=False)\n",
    "\n",
    "# Left Panel: Populations\n",
    "ax1.plot(t_fs, pop_exc, '-', color='C0', label='Excited state population')\n",
    "ax1.plot(t_fs, pop_gnd, '--', color='C1', label='Ground state population')\n",
    "#ax1.plot(t_fs, time_dependent_laser(t_fs), ':', color='C4', label='Laser field (scaled)')\n",
    "ax1.set_ylabel('Population')\n",
    "ax1.set_title('Populations')\n",
    "ax1.set_xlabel('Time (fs)')\n",
    "ax1.set_ylim(0, 1.05)\n",
    "ax1.legend(frameon=False)\n",
    "#ax1.set_xlim(0, 5)\n",
