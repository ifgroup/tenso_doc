    "# calculate the area of the pulse\n",
    "def calculate_area(t, field):\n",
    "    \"\"\"\n",
    "    Calculate the area under the pulse using Simpson's rule.\n",
    "    \n",
    "    Parameters:\n",
    "    t (array): Time array.\n",
    "    field (array): Electric field array.\n",
    "    \n",
    "    Returns:\n",
    "    float: Area under the pulse.\n",
    "    \"\"\"\n",
    "    return simpson(field, t)\n",
    "\n",
    "# Calculate the area of the pulse\n",
    "pulse_area = calculate_area(t_fs, semi(t_fs))\n",
    "print(f\"Area of the pulse: {pulse_area:.4f} cm^-1\")"
   ]
